# Copia este archivo como .env y completa los valores. .env está en .gitignore: NUNCA lo subas.
# En Render, estas variables se configuran en Environment, no en archivos.

# Neon -> Connect -> connection string (empieza con postgresql://). El código agrega el driver psycopg.
# Para desarrollo local sin Neon: DATABASE_URL=sqlite:///./local.db
DATABASE_URL=

# Fase 3
MODEL_PATH=models/model.joblib
